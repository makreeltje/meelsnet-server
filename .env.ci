# ============================================================
# CI dummy environment — used by the compose-validate job.
# All values are placeholders; none are real credentials.
#
# Keep this file in sync with compose files: if a PR adds a
# new variable, add it here too or the CI job will fail.
# ============================================================

# Paths — /tmp so docker compose config can resolve env_file stubs
DOCKER_DIR=/tmp/ci-conf
CONF_DIR=/tmp/ci-conf
MEDIA_DIR=/tmp/ci-media
DOWNLOAD_DIR=/tmp/ci-downloads
PHOTOS_DIR=/tmp/ci-photos
LOG_DIR=/tmp/ci-logs
CLOUD_DIR=/tmp/ci-cloud
DMS_DIR=/tmp/ci-dms
NVR_DIR=/tmp/ci-nvr
MNT_DIR=/tmp/ci-mnt
BACKUP_DIR=/tmp/ci-backup
ARCHIVE_DIR=/tmp/ci-archive

# User & Timezone
PUID=1000
PGID=1000
TZ=UTC

# Networking
DOMAINNAME_1=example.com
DOMAINNAME_2=example.local
HOSTNAME=ci
CLOUDFLARE_IPS=dummy
LOCAL_IPS=dummy
LAN_SUBNET=192.0.2.0/24
HOME_SUBNET=192.0.2.0/24

# Per-LXC IPs (RFC 5737 TEST-NET — not routable)
LXC_IP=192.0.2.1
LXC_INFRA_IP=192.0.2.10
LXC_MEDIA_IP=192.0.2.20
LXC_HOME_IP=192.0.2.30
LXC_PRODUCTIVITY_IP=192.0.2.40
LXC_NETWORK_IP=192.0.2.50
LXC_MONITORING_IP=192.0.2.60
LXC_JUICE_SHOP_IP=192.0.2.70
PROXMOX_IP=192.0.2.1
UNIFI_SYSTEM_IP=192.0.2.50

# Traefik
BYPASS_SECRET=dummy
TRAEFIK_AUTH_BYPASS_KEY=dummy

# Databases — PostgreSQL
PSQL_DBUSER=postgres
PSQL_DBPASS=dummy
AUTHENTIK_DBNAME=authentik
AUTHENTIK_DBUSER=authentik
AUTHENTIK_DBPASS=dummy
