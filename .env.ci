PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=dummy
PAPERLESS_AUTH_CLIENT_ID=dummy
PAPERLESS_AUTH_CLIENT_SECRET=dummy
NEXTCLOUD_DBNAME=nextcloud
NEXTCLOUD_DBUSER=nextcloud
NEXTCLOUD_DBPASS=dummy
N8N_DBNAME=n8n
N8N_DBUSER=n8n
N8N_DBPASS=dummy
PRINTER_CALCULATOR_DBNAME=printer_calculator
